# ---------- 生成物 ----------
# 整个 bin 都是编译出来的，data\ 也在里面（跟 exe 放在一起），一并不进库
bin/
obj/
*.user
*.suo

# ---------- 运行时数据 ----------
# config.json 里明文存着 QQ 邮箱授权码，readings / recharges 是这台机器自己攒的历史，
# 都不该跟着代码走。装在没写权限的目录时数据会落到 %APPDATA%\BillSystem\，那儿本来就在库外
data/
config.json
readings-*.jsonl
recharges-*.jsonl
*.jsonl.tmp
error.log

# ---------- 开发临时文件 ----------
# --screenshot 默认写 %TEMP%，但指定到项目里时别把出的图带进来（docs\ 下那几张是要进库的）
shots/
billsystem-selftest.txt

# ---------- 编辑器 / 工具 ----------
.vs/
.idea/
*.swp
.claude/settings.local.json
.claude/.claude-model-switch-active.json

# ---------- 系统 ----------
Thumbs.db
desktop.ini
.DS_Store

# ---------- 打包产物 ----------
# publish.bat 出来的自带运行时的整包（一百多兆），压成 zip 传 Release，不进库
publish/

# --selftest / --screenshot 各自的沙盒数据目录（都是假数据，跟着 exe 旁边生成）
dev-selftest/
dev-devshot/
